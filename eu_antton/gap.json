{"p":["eu_antton_g11.mp3"],"k":{"Bost eta erdi.":[0,0,5120],"Bost eta erdi, arratsaldean.":[0,5120,8882],"Bost. Eta erdi.":[0,14002,9404],"Ez horregatik. Euskaraz hitz egiten duzu?":[0,23406,14524],"Ondo hitz egiten duzu. Gero arte!":[0,37930,12852],"Egun on. Zer nahi duzu?":[0,50782,10031],"Hemen duzu.":[0,60813,4284],"Bi euro dira. Beste ezer?":[0,65097,11912],"Hiru euro dira.":[0,77009,5329],"Hemen duzu. Bihar arte!":[0,82338,11076],"tiketa":[0,93414,3344],"Arratsalde on. Zenbat zarete?":[0,96758,12330],"Ondo. Eseri, mesedez.":[0,109088,12016],"Bai, arraina eta okela. Zer nahi duzu?":[0,121104,14315],"Ardoa edo ura?":[0,135419,5433],"Hogei euro dira.":[0,140852,5538],"Bi gara":[0,146390,3762],"Kaixo, arratsalde on.":[0,150152,7105],"Bai, pisu bat dago.":[0,157257,6687],"Seiehun euro dira.":[0,163944,6269],"Pisua polita da.":[0,170213,5851],"Hondartzatik gertu dago.":[0,176064,7732],"Bai, garbia da.":[0,183796,6374],"garestia":[0,190170,4180],"Bai, eskaintzan dago.":[0,194350,7314],"Ondo. Hamar euro.":[0,201664,9822],"eskaintzan":[0,211486,4493],"Egun on. Zer moduz?":[0,215979,10449],"Nekatuta zaude?":[0,226428,5329],"Ondo lo egiten duzu?":[0,231757,5851],"Ura edan behar duzu.":[0,237608,5851],"Ondo. Ondo izan!":[0,243459,9509],"Egun on. Zer nahi duzue?":[0,252968,10867],"Beste bat?":[0,263835,4075],"Hemen duzue.":[0,267910,4493],"Lau euro dira. Agur!":[0,272403,10240],"kafe beltza":[0,282643,4389],"Gertu dago.":[0,287032,4284],"Ez, ez dago urrun. Zuzen eta ezkerrera.":[0,291316,15256],"Zuzen jarraitu eta gero ezkerrera.":[0,306572,9509],"Hori da.":[0,316081,3344],"Ez, oinez. Gertu dago.":[0,319425,12957],"Bai, gazta ona da.":[0,332382,6374],"Hamabost euro dira.":[0,338756,6060],"Eskerrik asko. Beste ezer?":[0,344816,11389],"Ondo izan!":[0,356205,4389],"Gazta ba al dago?":[0,360594,5224],"Hondartza urrun dago.":[0,365818,6165],"Bai, edo autobusa.":[0,371983,7523],"Ordu bat.":[0,379506,3657],"Ondo! Zuzen.":[0,383163,9300],"metroa hartu":[0,392463,5120],"oinez":[0,397583,3344],"Kaixo! Nola duzu izena?":[0,400927,12016],"Ni Ane naiz. Zer moduz?":[0,412943,11598],"Ondo! Euskaraz hitz egiten duzu?":[0,424541,13479],"Ondo hitz egiten duzu!":[0,438020,6478],"Ongi etorri, Max!":[0,444498,6165],"Nola duzu izena?":[0,450663,5851],"Gabon. Badakizue zer nahi duzuen?":[0,456514,14106],"Paella oso ona da gaur.":[0,470620,6583],"Arroza eta arraina.":[0,477203,5956],"Postrea nahi duzue?":[0,483159,5538],"Hogeita hamar euro dira.":[0,488697,6896],"Hau da gela.":[0,495593,4389],"Laurehun euro hilean.":[0,499982,6896],"Oso ondo!":[0,506878,4075],"Bihar. Inprimakia bete duzu?":[0,510953,12121],"Oso ondo. Bihar arte, beraz.":[0,523074,12957],"inprimakia bete":[0,536031,5747],"Egun on. Zertan lagun zaitzaket?":[0,541778,13375],"Zer behar duzu?":[0,555153,4911],"Oso ondo.":[0,560064,4284],"Pasaportea, kontratua eta inprimakia.":[0,564348,11598],"Ez da ezer. Asteartean hitzordua dago, hamarretan.":[0,575946,17972],"Oso ondo. Asteartera arte.":[0,593918,13061],"Kaixo! Zer moduz? Atzo ez zintudan ikusi.":[0,606979,19331],"Pena da! Kafe bat hartu nahi duzu asteburuan?":[0,626310,14420],"Oso ondo! Zein egunetan?":[0,640730,11285],"Bai, larunbata ondo datorkit. Zer ordutan?":[0,652015,16718],"Ados. Non geratuko gara?":[0,668733,10658],"Oso ondo! Larunbatera arte.":[0,679391,12434],"ondo datorkizu?":[0,691825,5224],"zortzi eta erdietan":[0,697049,6896],"Arratsalde on. Jaka hau gustatzen zaizu?":[0,703945,14629],"Berrogei euro. Zer moduz?":[0,718574,11598],"Bai, hemen duzu.":[0,730172,6165],"Oso ondo. Beste ezer?":[0,736337,11494],"Ados. Berrogei euro dira guztira.":[0,747831,12643],"handiegia":[0,760474,4493],"Kaixo! Pablo naiz, taldekoa.":[0,764967,13688],"Ongi etorri! Zertan egiten duzu lan?":[0,778655,13897],"A, ni bezala! Non bizi zara?":[0,792552,12643],"Eta lehen?":[0,805195,4284],"Oso ondo! Esperientzia duzu.":[0,809479,13061],"Hamarretan, bulegoan.":[0,822540,7210],"saltzailea":[0,829750,4389],"Arratsalde on. Zer gertatzen zaizu?":[0,834139,13793],"Pastilla hauek oso onak dira.":[0,847932,8777],"Sei euro.":[0,856709,4389],"Hiru egunean, jan ondoren.":[0,861098,8464],"hotzeria hartu":[0,869562,5224],"Eztarrian min dut":[0,874786,6060],"Kaixo, egun on.":[0,880846,6165],"Ni naiz. Gauza asko?":[0,887011,11180],"Pasa, pasa.":[0,898191,4702],"Kaixo. Beste ezer?":[0,902893,10344],"Sei euro dira.":[0,913237,5120],"Hemen duzu tiketa.":[0,918357,5747],"Nor da azkena?":[0,924104,4807],"Egun on, bizilaguna! Nora zoaz hain goiz?":[0,928911,14942],"Autoz?":[0,943853,3448],"Eta urrun dago?":[0,947301,4911],"Eta bihar? Euria egingo du.":[0,952212,11285],"Ni ere erdigunera noa bihar. Elkarrekin goaz?":[0,963497,16196],"Eskerrik asko! Bihar arte.":[0,979693,11703],"bizikletaz":[0,991396,4911],"Goazen":[0,996307,3762],"Kaixo! Zer moduz asteburua? Zer egin zenuen?":[0,1000069,19853],"Eta zer egin zenuen etxean?":[0,1019922,8464],"Zer aspergarria! Eta igandean?":[0,1028386,12643],"Oso ondo! Eta gaur? Zer moduz lana?":[0,1041029,17659],"Pena da! Zerbait hartzera goaz gaur gauean?":[0,1058688,14942],"Ados. Bihar arte!":[0,1073630,10240],"etxean geratu nintzen":[0,1083870,6896],"Oso ondo. Zenbat zarete?":[0,1090766,11912],"Larunbatean bai.":[0,1102678,5433],"Bederatzietan, Udaletxeko plazatik.":[0,1108111,10867],"Jaka bat eta ura.":[0,1118978,5851],"Paella bat, El Palmarren.":[0,1124829,7314]}}