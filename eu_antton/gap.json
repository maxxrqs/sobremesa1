{"p":["eu_antton_g12.mp3"],"k":{"Bai, esan?":[0,0,6583],"A, sentitzen dut. Zer gertatzen da?":[0,6583,15882],"Matxura bat izango da. Teknikari bati deituko diot.":[0,22465,16405],"Teknikaria ostegun arratsaldean joan daiteke.":[0,38870,11494],"Bai, ostiralean hamarretan. Ondo datorkizu?":[0,50364,15360],"Ez horregatik. Zerbait behar baduzu, deitu iezadazu.":[0,65724,17032],"berogailua":[0,82756,4598],"…izan daiteke?":[0,87354,4389],"Egun ona izan!":[0,91743,5538],"Egun on. Zergatik nahi duzu lanpostu hau?":[0,97281,14315],"Salmentan esperientziarik duzu?":[0,111596,8882],"Oso ondo. Lana bulegoan da, telelan egun batekin.":[0,120478,18181],"Bederatzietatik bostetara, bi hilabeteko proba aldiarekin.":[0,138659,16614],"Datorren hilean. Galderarik duzu?":[0,155273,13270],"Bai. Datorren astean deituko dizugu.":[0,168543,13479],"lanpostua":[0,182022,4493],"proba aldia":[0,186515,4598],"Noiz hasiko nintzateke?":[0,191113,7001],"Sukarra duzu?":[0,198114,4702],"Ez da ezer larria, hotzeria da.":[0,202816,8777],"Bai, hartu hau egunean hiru aldiz, jan ondoren.":[0,211593,12643],"Astebete. Eta edan ur asko.":[0,224236,12539],"Bai, baina hobeto ez bazaude, itzuli astelehenean.":[0,236775,13584],"eztula":[0,250359,3866],"hotzeria":[0,254225,4075],"sendagaia":[0,258300,4284],"Oso ondo. Hitzordua duzu?":[0,262584,12434],"Pasaportea eta alokairu kontratua utziko dizkidazu?":[0,275018,15464],"Bai, baina argiaren faktura ere behar dut.":[0,290482,10240],"Bai, posta elektronikoz. Hamar egun dituzu.":[0,300722,15882],"Astebete barru.":[0,316604,4807],"erroldatu":[0,321411,4284],"argiaren faktura":[0,325695,5851],"Noiz egongo da prest?":[0,331546,6165],"Arratsalde on. Zertan lagun zaitzaket?":[0,337711,14211],"Asko sentitzen dut. Pasaportea, mesedez?":[0,351922,14942],"Gaur ez, baina bihar zazpietan bat dago.":[0,366864,10971],"Aireportutik gertu gela bat ordainduko dizugu.":[0,377835,12121],"Zure ekipajea zurekin bidaiatuko da bihar.":[0,389956,11494],"Noski, hemen duzu. Barkatu eragozpenengatik.":[0,401450,16196],"ekipajea":[0,417646,4284],"Sukaldatzen ikasi nahi dut. Zer gomendatzen duzu?":[0,421930,15987],"Eskola bat garestiegia da.":[0,437917,7837],"Ados. Eta zein plater egingo dut lehenengo?":[0,445754,14420],"Eta gaizki egiten badut?":[0,460174,7105],"Arrazoi duzu. Etxera etorri nahi duzu?":[0,467279,14106],"Oso ondo. Eskerrik asko zure laguntzagatik!":[0,481385,16509],"…gomendatzen dizut":[0,497894,5851],"…aholkatzen dizut":[0,503745,5747],"normala da":[0,509492,4284],"prest dagoenean":[0,513776,5433],"Asko sentitzen dut. Noiz jaso zenuen?":[0,519209,14315],"Beste bat bidaltzea nahi duzu?":[0,533524,7837],"Bai, noski. Hamar bat egun beharko ditu.":[0,541361,15256],"Noski. Barkatu eragozpenengatik.":[0,556617,13584],"Nahiago nuke dirua itzultzea":[0,570201,8673],"Dena ondo joatea espero dut":[0,578874,7941],"Nola joan dira salmentak azken hilabeteetan?":[0,586815,12016],"Oso ondo. Eta fakturak?":[0,598831,12225],"Orduan, publizitatean gehiago inbertitu beharko genuke?":[0,611056,14524],"Bai, baina publizitaterik gabe ez dago hazkunderik.":[0,625580,12957],"Aurrera, entzuten zaitut.":[0,638537,7837],"Zentzuzkoa iruditzen zait. Proposamen bat prestatu dezakezu?":[0,646374,19435],"salmentak":[0,665809,4389],"fakturak":[0,670198,4075],"inbertitzen badugu":[0,674273,5956],"Zure errentamendu kontratua ekainean amaitzen da.":[0,680229,12330],"Baina alokairua ehuneko hamabost igoko dut.":[0,692559,11807],"Prezioak asko igo dira auzoan.":[0,704366,9091],"Egia da, beti ondo ordaindu duzu.":[0,713457,9613],"Zer proposatzen duzu?":[0,723070,7001],"Utzi pentsatzen, eta bihar deituko dizut.":[0,730071,11389],"errentamendu kontratua":[0,741460,7105],"bost urtez":[0,748565,4493],"sinatzen badugu":[0,753058,5433],"Zer moduz tratamendu berriarekin?":[0,758491,9300],"Zer sintoma dituzu?":[0,767791,6583],"Asko gertatzen da hasieran.":[0,774374,8359],"Pixka bat itxarotea nahiago dut. Berdin jarraituko bazenu, aldatuko genuke.":[0,782733,22779],"Bai, eta deitu iezadazu gaizki bazaude.":[0,805512,11912],"tratamendua":[0,817424,4598],"albo ondorioak":[0,822022,5642],"Ez litzateke hobe…?":[0,827664,5642],"Ikusi duzu kalea autoei itxiko dietela?":[0,833306,11076],"Niri ez zait gustatzen. Auto ilara gehiago egongo dira.":[0,844382,17450],"Bai, baina dendek bezeroak galduko dituzte.":[0,861832,11180],"Benetan? Eta nola joango gara erdigunera?":[0,873012,15673],"Bidegorri bat egongo balitz, agian erabiliko nuke.":[0,888685,13688],"Ikusiko dugu. Agian arrazoi duzu.":[0,902373,13688],"oinezkoentzako gunea":[0,916061,7105],"Ez dut uste egia denik":[0,923166,7001],"jasangarria":[0,930167,5016],"bidegorria":[0,935183,4702],"Kaixo, nirekin hitz egin nahi zenuen?":[0,939885,10240],"Benetan? Zergatik?":[0,950125,10344],"Eta soldata igotzen badugu?":[0,960469,7210],"Ulertzen dut. Noiz joango zinateke?":[0,967679,14002],"Eskerrik asko. Dena prest utziko duzu?":[0,981681,14211],"Eskerrik asko. Faltan botako zaitugu.":[0,995892,13375],"lana utzi":[0,1009267,4493],"denbora izan dezazun":[0,1013760,6583],"Plazer bat izan da":[0,1020343,5851],"Eskerrik asko etortzeagatik. Aste oso gogorra izan da.":[0,1026194,17972],"Ia inori ez nion abisatu, dena oso azkar gertatu zen.":[0,1044166,14942],"Eskerrik asko. Ez dakit noiz itzuliko naizen lanera.":[0,1059108,17554],"Nire bezeroek kezkatzen naute, egia esan.":[0,1076662,12643],"Ez dakit nola eskertu.":[0,1089305,7210],"Oso ona zara. Eskerrik asko benetan.":[0,1096515,14629],"Jakin izan banu":[0,1111144,5224],"Behar duzun denbora hartu":[0,1116368,7001],"behar duzun guztirako":[0,1123369,6896],"Enpresak kaleratzeak egin nahi ditu.":[0,1130265,10449],"Zenbakiak ez dira onak.":[0,1140714,7523],"Egia da, baina urte hau txarra da.":[0,1148237,9613],"Hori ez dago nire esku.":[0,1157850,7314],"Ez da horraino iritsi behar. Zer proposatzen duzue?":[0,1165164,16405],"kaleratzeak":[0,1181569,4911],"soldata masa":[0,1186480,5433],"Bestela":[0,1191913,3866],"aurreabisua luzatu":[0,1195779,6687],"Arratsalde on. Nork hitz egin nahi du?":[0,1202466,13793],"Ondo ezagutzen dugu hori.":[0,1216259,7523],"Badakigu, eta sentitzen dugu.":[0,1223782,9300],"Udal ordenantza berri bat onartuko dugu.":[0,1233082,10344],"Eta zuk zer proposatzen duzu?":[0,1243426,9091],"Ondo pentsatuko dugu.":[0,1252517,6374],"udal ordenantza":[0,1258891,5433],"neurri zehatzak":[0,1264324,5851],"Batzuen ustez, hiriak ez du bidegorri gehiago behar. Zer iritzi duzu?":[0,1270175,21211],"Zergatik?":[0,1291386,3971],"Baina auto gehiegi daude, ezta?":[0,1295357,9300],"Ikerketa baten arabera, bidegorriak ez dira erabiltzen.":[0,1304657,15360],"Minutu bat geratzen zaigu. Beste zerbait?":[0,1320017,15047],"Amaitzeko, zer esango zenuke?":[0,1335064,8986],"Ez nago argudio horrekin ados":[0,1344050,7523],"Ez dut ukatzen… denik":[0,1351573,6896],"inpartziala":[0,1358469,5329],"Egun on. Zer gertatzen da?":[0,1363798,12121],"Zer esaten du klausula horrek?":[0,1375919,8150],"Hori, egiaz, abusiboa izan daiteke.":[0,1384069,10762],"Lehenik, irakurri gabe sinatu zenuen?":[0,1394831,9927],"Erreklamazio bat aurkez dezakegu.":[0,1404758,9509],"Hiru hilabete inguru.":[0,1414267,6478],"aurreabisurik gabe":[0,1420745,6374],"horren inguruan":[0,1427119,5224],"Ongi etorri upategira.":[0,1432343,6792],"Irailean, udaren amaieran.":[0,1439135,8150],"Batez ere inguruko mota bat.":[0,1447285,8150],"Bai, aspalditik.":[0,1455435,6792],"Etorri datorren urtean, oso polita da.":[0,1462227,10971],"Oso gutxi, ia batere ez.":[0,1473198,8255],"mahats bilketa":[0,1481453,5224],"mahats mota":[0,1486677,4493],"jatorri deitura":[0,1491170,5433],"…gustatuko litzaidake":[0,1496603,6583]}}