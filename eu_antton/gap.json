{"p":["eu_antton_g12.mp3"],"k":{"Bai, esan?":[0,0,6374],"A, sentitzen dut. Zer gertatzen da?":[0,6374,14629],"Matxura bat izango da. Teknikari bati deituko diot.":[0,21003,17450],"Teknikaria ostegun arratsaldean joan daiteke.":[0,38453,11807],"Bai, ostiralean hamarretan. Ondo datorkizu?":[0,50260,16614],"Ez horregatik. Zerbait behar baduzu, deitu iezadazu.":[0,66874,17345],"berogailua":[0,84219,4493],"…izan daiteke?":[0,88712,4284],"Egun ona izan!":[0,92996,5224],"Egun on. Zergatik nahi duzu lanpostu hau?":[0,98220,14420],"Salmentan esperientziarik duzu?":[0,112640,8777],"Oso ondo. Lana bulegoan da, telelan egun batekin.":[0,121417,17763],"Bederatzietatik bostetara, bi hilabeteko proba aldiarekin.":[0,139180,16718],"Datorren hilean. Galderarik duzu?":[0,155898,12539],"Bai. Datorren astean deituko dizugu.":[0,168437,13479],"lanpostua":[0,181916,4284],"proba aldia":[0,186200,4598],"Noiz hasiko nintzateke?":[0,190798,7210],"Sukarra duzu?":[0,198008,4911],"Ez da ezer larria, hotzeria da.":[0,202919,8359],"Bai, hartu hau egunean hiru aldiz, jan ondoren.":[0,211278,12539],"Astebete. Eta edan ur asko.":[0,223817,12748],"Bai, baina hobeto ez bazaude, itzuli astelehenean.":[0,236565,13375],"eztula":[0,249940,3971],"hotzeria":[0,253911,4075],"sendagaia":[0,257986,4180],"Oso ondo. Hitzordua duzu?":[0,262166,12643],"Pasaportea eta alokairu kontratua utziko dizkidazu?":[0,274809,14838],"Bai, baina argiaren faktura ere behar dut.":[0,289647,9927],"Bai, posta elektronikoz. Hamar egun dituzu.":[0,299574,15673],"Astebete barru.":[0,315247,4807],"erroldatu":[0,320054,4284],"argiaren faktura":[0,324338,5642],"Noiz egongo da prest?":[0,329980,6060],"Arratsalde on. Zertan lagun zaitzaket?":[0,336040,14629],"Asko sentitzen dut. Pasaportea, mesedez?":[0,350669,16091],"Gaur ez, baina bihar zazpietan bat dago.":[0,366760,10971],"Aireportutik gertu gela bat ordainduko dizugu.":[0,377731,11912],"Zure ekipajea zurekin bidaiatuko da bihar.":[0,389643,11703],"Noski, hemen duzu. Barkatu eragozpenengatik.":[0,401346,16300],"ekipajea":[0,417646,4284],"Kaixo, sukaldatzen ikasi nahi dut. Zer gomendatzen duzu?":[0,421930,18286],"Eskola bat garestiegia da.":[0,440216,7628],"Ados. Eta zein plater egingo dut lehenengo?":[0,447844,15464],"Eta gaizki egiten badut?":[0,463308,7210],"Arrazoi duzu. Etxera etorri nahi duzu?":[0,470518,14211],"Oso ondo. Eskerrik asko zure laguntzagatik!":[0,484729,16927],"…gomendatzen dizut":[0,501656,5851],"…aholkatzen dizut":[0,507507,5851],"normala da":[0,513358,4493],"prest dagoenean":[0,517851,5433],"Asko sentitzen dut. Noiz jaso zenuen?":[0,523284,14106],"Beste bat bidaltzea nahi duzu?":[0,537390,7628],"Bai, noski. Hamar bat egun beharko ditu.":[0,545018,15569],"Noski. Barkatu eragozpenengatik.":[0,560587,13688],"Nahiago nuke dirua itzultzea":[0,574275,8673],"Dena ondo joatea espero dut":[0,582948,7941],"Hasiko gara. Nola joan dira salmentak azken hiru hilabeteetan?":[0,590889,19958],"Oso ondo. Eta fakturak?":[0,610847,12330],"Orduan, publizitatean gehiago inbertitu beharko genuke?":[0,623177,13793],"Bai, baina publizitaterik gabe ez dago hazkunderik.":[0,636970,12225],"Aurrera, entzuten zaitut.":[0,649195,8359],"Zentzuzkoa iruditzen zait. Proposamen bat prestatu dezakezu?":[0,657554,19958],"salmentak":[0,677512,4389],"fakturak":[0,681901,3866],"inbertitzen badugu":[0,685767,5956],"Errentamendu kontratuagatik deitzen dizut. Ekainean amaitzen da.":[0,691723,19853],"Baina alokairua ehuneko hamabost igoko dut.":[0,711576,11076],"Prezioak asko igo dira auzoan.":[0,722652,9195],"Egia da, beti ondo ordaindu duzu.":[0,731847,9822],"Zer proposatzen duzu?":[0,741669,6792],"Utzi pentsatzen, eta bihar deituko dizut.":[0,748461,11598],"errentamendu kontratua":[0,760059,7105],"bost urtez":[0,767164,4702],"sinatzen badugu":[0,771866,5851],"Zer moduz tratamendu berriarekin?":[0,777717,9195],"Zer sintoma dituzu?":[0,786912,6269],"Asko gertatzen da hasieran.":[0,793181,8359],"Pixka bat itxarotea nahiago dut. Berdin jarraituko bazenu, aldatuko genuke.":[0,801540,21838],"Bai, eta deitu iezadazu gaizki bazaude.":[0,823378,11912],"tratamendua":[0,835290,4598],"albo ondorioak":[0,839888,5642],"Ez litzateke hobe…?":[0,845530,5538],"Ikusi duzu kalea autoei itxiko dietela?":[0,851068,10867],"Niri ez zait gustatzen. Auto ilara gehiago egongo dira.":[0,861935,17554],"Bai, baina dendek bezeroak galduko dituzte.":[0,879489,11285],"Benetan? Eta nola joango gara erdigunera?":[0,890774,15778],"Bidegorri bat egongo balitz, agian erabiliko nuke.":[0,906552,12852],"Ikusiko dugu. Agian arrazoi duzu.":[0,919404,13688],"oinezkoentzako gunea":[0,933092,7105],"Ez dut uste egia denik":[0,940197,7001],"jasangarria":[0,947198,5120],"bidegorria":[0,952318,4598],"Kaixo, nirekin hitz egin nahi zenuen?":[0,956916,10344],"Benetan? Zergatik?":[0,967260,10553],"Eta soldata igotzen badugu?":[0,977813,7732],"Ulertzen dut. Noiz joango zinateke?":[0,985545,14629],"Eskerrik asko. Dena prest utziko duzu?":[0,1000174,14315],"Eskerrik asko. Faltan botako zaitugu.":[0,1014489,13584],"denbora izan dezazun":[0,1028073,6478],"Plazer bat izan da":[0,1034551,5851],"Eskerrik asko etortzeagatik. Aste oso gogorra izan da.":[0,1040402,18181],"Ia inori ez nion abisatu, dena oso azkar gertatu zen.":[0,1058583,14942],"Eskerrik asko. Ez dakit noiz itzuliko naizen lanera.":[0,1073525,17554],"Nire bezeroek kezkatzen naute, egia esan.":[0,1091079,13166],"Ez dakit nola eskertu.":[0,1104245,7210],"Oso ona zara. Eskerrik asko benetan.":[0,1111455,14838],"Jakin izan banu":[0,1126293,5433],"Behar duzun denbora hartu":[0,1131726,7210],"behar duzun guztirako":[0,1138936,6792],"Enpresak enplegu erregulazioko espediente bat aurkeztuko du.":[0,1145728,15256],"Zenbakiak ez dira onak.":[0,1160984,7523],"Egia da, baina urte hau txarra da.":[0,1168507,9195],"Hori ez dago nire esku.":[0,1177702,6792],"Ez da horraino iritsi behar. Zer proposatzen duzue?":[0,1184494,16718],"enplegu erregulazioko espedientea":[0,1201212,9822],"soldata masa":[0,1211034,5224],"Bestela":[0,1216258,3866],"aurreabisua luzatu":[0,1220124,6478],"Arratsalde on guztioi. Nork hitz egin nahi du lehenengo?":[0,1226602,17241],"Ondo ezagutzen dugu hori.":[0,1243843,7105],"Badakigu, eta sentitzen dugu.":[0,1250948,9509],"Udal ordenantza berri bat onartuko dugu.":[0,1260457,10553],"Eta zuk zer proposatzen duzu?":[0,1271010,9300],"Ondo pentsatuko dugu.":[0,1280310,6374],"udal ordenantza":[0,1286684,5747],"neurri zehatzak":[0,1292431,5747],"Batzuen ustez, hiriak ez du bidegorri gehiago behar. Zer iritzi duzu?":[0,1298178,20689],"Zergatik?":[0,1318867,4075],"Baina auto gehiegi daude, ezta?":[0,1322942,9300],"Ikerketa baten arabera, bidegorriak ez dira erabiltzen.":[0,1332242,14629],"Minutu bat geratzen zaigu. Beste zerbait?":[0,1346871,14629],"Amaitzeko, zer esango zenuke?":[0,1361500,9300],"Ez nago argudio horrekin ados":[0,1370800,7628],"Ez dut ukatzen… denik":[0,1378428,6687],"inpartziala":[0,1385115,4807],"Egun on. Kontatu, zer gertatzen da?":[0,1389922,14629],"Zer esaten du klausula horrek?":[0,1404551,8359],"Hori, egiaz, abusiboa izan daiteke.":[0,1412910,10762],"Lehenik, irakurri gabe sinatu zenuen?":[0,1423672,10449],"Erreklamazio bat aurkez dezakegu.":[0,1434121,9404],"Hiru hilabete inguru.":[0,1443525,5956],"aurreabisurik gabe":[0,1449481,6374],"horren inguruan":[0,1455855,5224],"Ongi etorri upategira. Hemen ardoa egiten dugu.":[0,1461079,16509],"Irailean, udaren amaieran.":[0,1477588,8464],"Batez ere inguruko mota bat.":[0,1486052,8150],"Bai, aspalditik.":[0,1494202,7105],"Etorri datorren urtean, oso polita da.":[0,1501307,11076],"Oso gutxi, ia batere ez.":[0,1512383,8359],"mahats bilketa":[0,1520742,5329],"mahats mota":[0,1526071,4598],"jatorri deitura":[0,1530669,5329],"…gustatuko litzaidake":[0,1535998,6896]}}