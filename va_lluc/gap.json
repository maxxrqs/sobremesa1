{"p":["va_lluc_g10.mp3"],"k":{"Són les cinc.":[0,0,3971],"Són les cinc de la vesprada.":[0,3971,6896],"Les cinc.":[0,10867,3135],"De res. Parla valencià?":[0,14002,7210],"Parla molt bé. Fins després!":[0,21212,8464],"Pot repetir?":[0,29676,3448],"Bon dia. Què vol?":[0,33124,4807],"Ací té.":[0,37931,2926],"Costa dos euros. Alguna cosa més?":[0,40857,9509],"Són tres euros.":[0,50366,4911],"Ací té. Fins demà!":[0,55277,5851],"Molt bé. Per ací.":[0,61128,5642],"Ací té. Què vol?":[0,66770,5433],"Molt bé. I per a beure?":[0,72203,6478],"Són vint euros.":[0,78681,4911],"la carta":[0,83592,3030],"Hola, bona vesprada.":[0,86622,5538],"Tinc un pis per a dos.":[0,92160,5956],"Costa sis-cents euros.":[0,98116,6165],"És un pis molt bonic.":[0,104281,6060],"Està prop de la platja.":[0,110341,6269],"Sí, és gran.":[0,116610,4702],"Ho he de pensar":[0,121312,4389],"Bon dia. En què el puc ajudar?":[0,125701,8046],"Molt bé. Un moment, per favor.":[0,133747,8464],"Sí, està d'oferta.":[0,142211,5851],"Costa deu euros.":[0,148062,5224],"Sí, pot pagar amb targeta. Gràcies.":[0,153286,10136],"M'ho emporte":[0,163422,3344],"Bon dia. Què li passa?":[0,166766,6269],"Què li fa mal?":[0,173035,3866],"Dorm bé?":[0,176901,2926],"Ha de beure aigua.":[0,179827,4911],"Molt bé. Fins després!":[0,184738,6687],"Bon dia. Què volen prendre?":[0,191425,7314],"I per a ella?":[0,198739,3762],"Ací tenen.":[0,202501,3762],"Són quatre euros. Bon cap de setmana!":[0,206263,9718],"Bon cap de setmana!":[0,215981,4911],"Està prop.":[0,220892,3135],"No, no està lluny. Tot recte i després a la dreta.":[0,224027,14106],"Tot recte i després a la dreta.":[0,238133,7732],"No molt.":[0,245865,2926],"l'estació de metro":[0,248791,5329],"Bon dia. Què li pose?":[0,254120,6269],"Sí, el formatge és molt bo.":[0,260389,8046],"Són quinze euros.":[0,268435,5224],"Gràcies. Alguna cosa més?":[0,273659,7941],"Hola, què li passa?":[0,281600,4702],"On va?":[0,286302,2612],"La platja està lluny d'ací.":[0,288914,6583],"Sí, o l'autobús.":[0,295497,5329],"Amb metro, poc. Caminant, una hora.":[0,300826,9300],"Molt bé! Tot recte.":[0,310126,5956],"Estic perdut":[0,316082,4284],"Hola! Com et diuen?":[0,320366,5224],"Jo soc l'Anna. Com estàs?":[0,325590,7419],"Que bé! Parles valencià?":[0,333009,6687],"Parles molt bé!":[0,339696,4180],"Encantada, Max.":[0,343876,5747],"Bona nit. Ja saben què volen?":[0,349623,8046],"La paella de la casa està molt bona.":[0,357669,8986],"Porta arròs, carn i verdures.":[0,366655,7837],"Volen postres?":[0,374492,4180],"Són trenta euros.":[0,378672,5329],"Què em recomana?":[0,384001,4284],"per a compartir":[0,388285,4180],"Pague jo":[0,392465,2926],"Esta és l'habitació. És un pis compartit.":[0,395391,11807],"Quatre-cents euros al mes.":[0,407198,6896],"Que bé!":[0,414094,2403],"Demà, si vol. Té el formulari?":[0,416497,8673],"Perfecte. Fins demà.":[0,425170,6269],"signar el contracte":[0,431439,5538],"Bon dia. En què puc ajudar-lo?":[0,436977,8359],"Per a què és la cita?":[0,445336,5120],"El passaport, el contracte de lloguer i el formulari.":[0,450456,12852],"No passa res. Hi ha cita dimarts a les deu.":[0,463308,11389],"Perfecte. Fins dimarts.":[0,474697,6792],"demanar cita prèvia":[0,481489,6060],"Hola! Què tal? Ahir no et vaig veure.":[0,487549,9613],"Quina llàstima! Et ve de gust un cafè esta setmana?":[0,497162,12225],"Molt bé! Quin dia?":[0,509387,5329],"Sí, dissabte em va bé. A quina hora?":[0,514716,9509],"D'acord. On quedem?":[0,524225,5851],"Perfecte! Fins dissabte.":[0,530076,7314],"Et ve de gust un cafè?":[0,537390,5956],"Et va bé?":[0,543346,3239],"Quedem a les huit":[0,546585,4702],"Bona vesprada. Li agrada esta jaqueta?":[0,551287,10449],"Quaranta euros. Què tal li va?":[0,561736,7941],"Sí, ací té.":[0,569677,4598],"Molt bé. Alguna cosa més?":[0,574275,7314],"D'acord. Quaranta euros.":[0,581589,6687],"Em va gran":[0,588276,3553],"Quede's el canvi":[0,591829,4598],"Hola! Soc Pau, de l'equip de vendes.":[0,596427,9718],"Benvingut! De què treballes?":[0,606145,7523],"Mira, com jo! Fa molt de temps que estàs ací?":[0,613668,11703],"I abans?":[0,625371,3239],"Que bé! Tens experiència.":[0,628610,7419],"A les deu. Ens veiem allí.":[0,636029,6792],"De què treballes?":[0,642821,4702],"Fa tres mesos":[0,647523,4702],"Bona vesprada. Què li passa?":[0,652225,7732],"Vaja. Alguna cosa més?":[0,659957,7523],"Li done una pastilla. Té al·lèrgia a alguna cosa?":[0,667480,12225],"Esta no porta llet.":[0,679705,4911],"Sis euros.":[0,684616,3971],"Tres al dia, després de menjar.":[0,688587,8255],"Hola, bon dia.":[0,696842,4180],"Soc jo. Porta moltes coses?":[0,701022,8464],"Passe, passe.":[0,709486,4180],"Hola. Bon dia.":[0,713666,4180],"Sis euros. Amb targeta?":[0,717846,7210],"Ací té el canvi.":[0,725056,4911],"Qui és el darrer?":[0,729967,3971],"Bon dia, veí! On vas tan d'hora?":[0,733938,8464],"Amb cotxe?":[0,742402,3030],"I està lluny?":[0,745432,3553],"I demà? Diuen que farà mal temps.":[0,748985,8777],"Jo també vaig al centre demà. Anem junts?":[0,757762,10553],"Molt bé! Fins demà.":[0,768315,5747],"a prop de":[0,774062,3135],"Hola! Què tal el cap de setmana? Què vas fer?":[0,777197,10867],"I què vas fer a casa?":[0,788064,5538],"Quin avorriment! I diumenge?":[0,793602,7628],"Que bé! I hui? Què tal el treball?":[0,801230,8150],"Quina llàstima! Anem a prendre alguna cosa esta nit?":[0,809380,12748],"D'acord. Fins demà!":[0,822128,6060],"Em vaig quedar a casa":[0,828188,5642],"Bon dia. Què desitja?":[0,833830,6478],"Molt bé. Per a quantes persones?":[0,840308,8673],"Dissabte hi ha places.":[0,848981,6060],"A les nou, des de la plaça de l'Ajuntament.":[0,855041,10553],"Una jaqueta i aigua.":[0,865594,5747],"Sí, una paella al Palmar.":[0,871341,7419],"reservar una excursió":[0,878760,6374],"Cal portar alguna cosa?":[0,885134,6374],"el dinar":[0,891508,3030]}}