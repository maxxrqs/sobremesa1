{"p":["va_gina_g10.mp3"],"k":{"Són les cinc.":[0,0,3866],"Són les cinc de la vesprada.":[0,3866,6269],"Les cinc.":[0,10135,3135],"De res. Parla valencià?":[0,13270,6792],"Parla molt bé. Fins després!":[0,20062,7105],"Pot repetir?":[0,27167,3344],"Bon dia. Què vol?":[0,30511,4807],"Ací té.":[0,35318,2821],"Costa dos euros. Alguna cosa més?":[0,38139,10136],"Són tres euros.":[0,48275,4598],"Ací té. Fins demà!":[0,52873,5851],"Molt bé. Per ací.":[0,58724,5016],"Ací té. Què vol?":[0,63740,5224],"Molt bé. I per a beure?":[0,68964,6060],"Són vint euros.":[0,75024,4389],"la carta":[0,79413,2821],"Hola, bona vesprada.":[0,82234,5329],"Tinc un pis per a dos.":[0,87563,5433],"Costa sis-cents euros.":[0,92996,5851],"És un pis molt bonic.":[0,98847,5538],"Està prop de la platja.":[0,104385,6060],"Sí, és gran.":[0,110445,4180],"Ho he de pensar":[0,114625,4075],"Bon dia. En què el puc ajudar?":[0,118700,7941],"Molt bé. Un moment, per favor.":[0,126641,7732],"Sí, està d'oferta.":[0,134373,5538],"Costa deu euros.":[0,139911,4284],"Sí, pot pagar amb targeta. Gràcies.":[0,144195,9613],"M'ho emporte":[0,153808,3448],"Bon dia. Què li passa?":[0,157256,5851],"Què li fa mal?":[0,163107,3657],"Dorm bé?":[0,166764,3030],"Ha de beure aigua.":[0,169794,4493],"Molt bé. Fins després!":[0,174287,6478],"Bon dia. Què volen prendre?":[0,180765,6896],"I per a ella?":[0,187661,3553],"Ací tenen.":[0,191214,3553],"Són quatre euros. Bon cap de setmana!":[0,194767,9509],"Bon cap de setmana!":[0,204276,4911],"Està prop.":[0,209187,3448],"No, no està lluny. Tot recte i després a la dreta.":[0,212635,11807],"Tot recte i després a la dreta.":[0,224442,7837],"No molt.":[0,232279,2926],"l'estació de metro":[0,235205,5120],"Bon dia. Què li pose?":[0,240325,5851],"Sí, el formatge és molt bo.":[0,246176,7523],"Són quinze euros.":[0,253699,4702],"Gràcies. Alguna cosa més?":[0,258401,7628],"Hola, què li passa?":[0,266029,4807],"On va?":[0,270836,2403],"La platja està lluny d'ací.":[0,273239,6269],"Sí, o l'autobús.":[0,279508,5747],"Amb metro, poc. Caminant, una hora.":[0,285255,9091],"Molt bé! Tot recte.":[0,294346,5747],"Estic perdut":[0,300093,3971],"Hola! Com et diuen?":[0,304064,5642],"Jo soc l'Anna. Com estàs?":[0,309706,6896],"Que bé! Parles valencià?":[0,316602,6269],"Parles molt bé!":[0,322871,4389],"Encantada, Max.":[0,327260,5329],"Bona nit. Ja saben què volen?":[0,332589,8046],"La paella de la casa està molt bona.":[0,340635,8464],"Porta arròs, carn i verdures.":[0,349099,7523],"Volen postres?":[0,356622,4493],"Són trenta euros.":[0,361115,4702],"Què em recomana?":[0,365817,3971],"per a compartir":[0,369788,3971],"Pague jo":[0,373759,2821],"Esta és l'habitació. És un pis compartit.":[0,376580,11285],"Quatre-cents euros al mes.":[0,387865,6374],"Que bé!":[0,394239,2194],"Demà, si vol. Té el formulari?":[0,396433,8255],"Perfecte. Fins demà.":[0,404688,5851],"signar el contracte":[0,410539,5224],"Bon dia. En què puc ajudar-lo?":[0,415763,8150],"Per a què és la cita?":[0,423913,5016],"El passaport, el contracte de lloguer i el formulari.":[0,428929,12225],"No passa res. Hi ha cita dimarts a les deu.":[0,441154,10136],"Perfecte. Fins dimarts.":[0,451290,6687],"demanar cita prèvia":[0,457977,5747],"Hola! Què tal? Ahir no et vaig veure.":[0,463724,9195],"Quina llàstima! Et ve de gust un cafè esta setmana?":[0,472919,11494],"Molt bé! Quin dia?":[0,484413,5120],"Sí, dissabte em va bé. A quina hora?":[0,489533,8986],"D'acord. On quedem?":[0,498519,5329],"Perfecte! Fins dissabte.":[0,503848,7001],"Et ve de gust un cafè?":[0,510849,5956],"Et va bé?":[0,516805,2821],"Quedem a les huit":[0,519626,4075],"Bona vesprada. Li agrada esta jaqueta?":[0,523701,9927],"Quaranta euros. Què tal li va?":[0,533628,7210],"Sí, ací té.":[0,540838,4598],"Molt bé. Alguna cosa més?":[0,545436,6896],"D'acord. Quaranta euros.":[0,552332,6687],"Em va gran":[0,559019,3448],"Quede's el canvi":[0,562467,4180],"Hola! Soc Pau, de l'equip de vendes.":[0,566647,8882],"Benvingut! De què treballes?":[0,575529,7001],"Mira, com jo! Fa molt de temps que estàs ací?":[0,582530,10658],"I abans?":[0,593188,2926],"Que bé! Tens experiència.":[0,596114,6687],"A les deu. Ens veiem allí.":[0,602801,6792],"De què treballes?":[0,609593,4284],"Fa tres mesos":[0,613877,4493],"Bona vesprada. Què li passa?":[0,618370,7001],"Vaja. Alguna cosa més?":[0,625371,7628],"Li done una pastilla. Té al·lèrgia a alguna cosa?":[0,632999,11703],"Esta no porta llet.":[0,644702,5433],"Sis euros.":[0,650135,3971],"Tres al dia, després de menjar.":[0,654106,7941],"Hola, bon dia.":[0,662047,4284],"Soc jo. Porta moltes coses?":[0,666331,8359],"Passe, passe.":[0,674690,3971],"Hola. Bon dia.":[0,678661,4389],"Sis euros. Amb targeta?":[0,683050,6896],"Ací té el canvi.":[0,689946,4493],"Qui és el darrer?":[0,694439,3971],"Bon dia, veí! On vas tan d'hora?":[0,698410,8986],"Amb cotxe?":[0,707396,2926],"I està lluny?":[0,710322,3553],"I demà? Diuen que farà mal temps.":[0,713875,8150],"Jo també vaig al centre demà. Anem junts?":[0,722025,10240],"Molt bé! Fins demà.":[0,732265,5016],"a prop de":[0,737281,3030],"Hola! Què tal el cap de setmana? Què vas fer?":[0,740311,10240],"I què vas fer a casa?":[0,750551,5433],"Quin avorriment! I diumenge?":[0,755984,7314],"Que bé! I hui? Què tal el treball?":[0,763298,7314],"Quina llàstima! Anem a prendre alguna cosa esta nit?":[0,770612,11285],"D'acord. Fins demà!":[0,781897,5956],"Em vaig quedar a casa":[0,787853,5329],"Bon dia. Què desitja?":[0,793182,6165],"Molt bé. Per a quantes persones?":[0,799347,7732],"Dissabte hi ha places.":[0,807079,5851],"A les nou, des de la plaça de l'Ajuntament.":[0,812930,9822],"Una jaqueta i aigua.":[0,822752,5329],"Sí, una paella al Palmar.":[0,828081,6687],"reservar una excursió":[0,834768,5956],"Cal portar alguna cosa?":[0,840724,6060],"el dinar":[0,846784,2926]}}