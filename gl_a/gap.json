{"p":["gl_a_g12.mp3"],"k":{"Bos días, que desexa?":[0,0,5642],"Aquí ten. Algo máis?":[0,5642,8986],"O queixo é moi bo hoxe.":[0,14628,5747],"Custa seis euros.":[0,20375,5224],"Son oito euros.":[0,25599,5120],"Si, pode pagar con tarxeta. Grazas, ata logo!":[0,30719,14838],"Bos días, en que podo axudalo?":[0,45557,7314],"O próximo tren sae ás once e media.":[0,52871,8882],"Si, pero ten que pagar cinco euros máis.":[0,61753,9509],"Si, claro. Vai volver hoxe?":[0,71262,9613],"Moi ben. Aquí ten o seu billete. Boa viaxe!":[0,80875,16091],"perder o tren":[0,96966,3866],"o próximo tren":[0,100832,4807],"Boa viaxe!":[0,105639,3657]}}